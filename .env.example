# GEMINI_API_KEY: Optional runtime key for future AI assistance
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet or API is hosted
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# DATABASE_URL: MySQL 8 relational connection string for Prisma ORM
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=prefer
# In development without an external MySQL instance, the app falls back to read-only fixtures
# with explicit UI & API warnings so data persistence is never faked.
DATABASE_URL="mysql://store_admin:secure_password_here@localhost:3306/personalised_store_db?connect_timeout=5"

# SECURITY & AUTHENTICATION
JWT_SECRET="change-this-to-secure-256-bit-random-secret-in-production"
JWT_EXPIRATION_HOURS=24
ADMIN_MFA_ENFORCED="true"
SESSION_COOKIE_SECRET="change-this-cookie-signing-secret"

# FILE STORAGE ABSTRACTION (Private S3/Local driver)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
STORAGE_MAX_UPLOAD_MB=15
STORAGE_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,image/svg+xml"

# CORS & SECURITY HEADERS
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
